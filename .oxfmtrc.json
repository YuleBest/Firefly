{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "astro": true,
  "svelte": true,
  "ignorePatterns": [
    "**/src/**/*.styl",
    "**/src/content/**",
    "**/dist/**/*",
    "**/node_modules/**/*",
    "**/src/constants/icons-data.json",
    "**/src/constants/lqips.json"
  ],
  "overrides": [
    {
      "files": ["**/*.css", "**/*.scss", "**/*.less"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ]
}
