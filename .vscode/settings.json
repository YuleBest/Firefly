{
  // 项目使用本地安装的 Oxc 工具链：Oxlint 负责 lint，Oxfmt 负责格式化。
  // Oxfmt 能正确保留 Tailwind v4 的 `transition!` 后缀，CSS 也可以交给它格式化。
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // 避免 @apply / @theme / @reference 等 Tailwind 指令被标成未知 at-rule
  "css.lint.unknownAtRules": "ignore",

  // Tailwind v4 使用 CSS-first 配置
  "tailwindCSS.experimental.configFile": "src/styles/main.css",

  // 与 .oxfmtrc.json 的 tabWidth 保持一致
  "editor.insertSpaces": false,
  "editor.tabSize": 2,

  // 减少项目内搜索/文件监听的噪音
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/.astro": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/.astro/**": true
  }
}
